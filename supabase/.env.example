# Copy to supabase/.env (git-ignored) and fill in. Never paste these into chat.

# Optional if SUPABASE_URL is set (it is the first part of the URL).
# supabase.com > your project > Project Settings > General > "Project ID"
SUPABASE_PROJECT_REF=
# Project Settings > API (or "Data API"): Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Project Settings > API Keys: the "publishable" key (sb_publishable_..., or the
# older "anon" key). Safe to ship in the app.
SUPABASE_ANON_KEY=
# Project Settings > API Keys: the "secret" key (sb_secret_...). Server-side
# only: it is stored as a function secret and never reaches the app.
SUPABASE_SECRET_KEY=
# The database password you chose when creating the project
# (Project Settings > Database > Reset database password if forgotten)
SUPABASE_DB_PASSWORD=
# https://supabase.com/dashboard/account/tokens > Generate new token (lets the CLI
# deploy). Or leave empty and run `npx supabase login` once on this PC instead.
SUPABASE_ACCESS_TOKEN=

# Telegram > @BotFather > /newbot > the token it gives you
TELEGRAM_BOT_TOKEN=
# Any long random string; Telegram sends it back with every webhook call.
# Leave empty and the setup script generates one.
TELEGRAM_WEBHOOK_SECRET=

# Optional. Domain of the placeholder address each account gets (no mail is
# ever sent). Leave empty for the default, the project's own host name.
LOGIN_EMAIL_DOMAIN=
